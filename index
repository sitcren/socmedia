<!DOCTYPE html>
<html lang="pt">
<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>SOC Media — Agência Criativa</title>

    <meta
        name="description"
        content="SOC Media — Publicidade, Audiovisual, Design, Social Media, Websites e Soluções Digitais."
    >

    <!-- =====================================================
         BOOTSTRAP
    ====================================================== -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >


    <!-- =====================================================
         GOOGLE FONT
    ====================================================== -->

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com"
    >

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin
    >

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >


    <style>

        /* =====================================================
           VARIABLES
        ====================================================== */

        :root {

            --bg: #080808;

            --white: #f5f4ef;

            --black: #111111;

            --gray: #858585;

            --light-gray: #e9e7e1;

            --line: rgba(255,255,255,.15);

            --accent: #ff5b22;

        }



        /* =====================================================
           RESET
        ====================================================== */

        * {
            box-sizing: border-box;
        }


        html {
            scroll-behavior: smooth;
        }


        body {

            margin: 0;

            background:
                var(--bg);

            color:
                var(--white);

            font-family:
                'Inter',
                sans-serif;

            overflow-x:
                hidden;
        }


        a {

            text-decoration:
                none;

            color:
                inherit;
        }



        /* =====================================================
           HEADER
        ====================================================== */

        .site-header {

            position:
                absolute;

            top:
                0;

            left:
                0;

            width:
                100%;

            z-index:
                100;
        }


        .navbar {

            padding:
                25px 0;
        }


        .brand {

            font-size:
                30px;

            font-weight:
                900;

            letter-spacing:
                -2px;
        }


        .brand span {

            color:
                var(--accent);
        }


        .nav-link {

            color:
                rgba(255,255,255,.85) !important;

            font-size:
                11px;

            text-transform:
                uppercase;

            letter-spacing:
                .1em;

            transition:
                .3s;
        }


        .nav-link:hover {

            color:
                var(--accent) !important;
        }


        .nav-contact {

            border:
                1px solid
                rgba(255,255,255,.35);

            border-radius:
                50px;

            padding:
                11px 18px !important;
        }



        /* =====================================================
           HERO
        ====================================================== */

        .hero {

            height:
                100vh;

            min-height:
                700px;

            position:
                relative;

            overflow:
                hidden;

            display:
                flex;

            align-items:
                center;
        }



        /* =====================================================
           YOUTUBE VIDEO
        ====================================================== */

        .hero-video {

            position:
                absolute;

            inset:
                0;

            width:
                100%;

            height:
                100%;

            overflow:
                hidden;

            z-index:
                0;
        }


        .hero-video iframe {

            position:
                absolute;

            top:
                50%;

            left:
                50%;

            width:
                100vw;

            height:
                56.25vw;

            min-height:
                100vh;

            min-width:
                177.78vh;

            transform:
                translate(
                    -50%,
                    -50%
                );

            border:
                0;

            pointer-events:
                none;
        }



        /* =====================================================
           VIDEO OVERLAY
        ====================================================== */

        .hero-overlay {

            position:
                absolute;

            inset:
                0;

            z-index:
                1;

            background:

                linear-gradient(
                    90deg,
                    rgba(0,0,0,.92) 0%,
                    rgba(0,0,0,.68) 38%,
                    rgba(0,0,0,.30) 75%,
                    rgba(0,0,0,.45) 100%
                ),

                linear-gradient(
                    0deg,
                    rgba(0,0,0,.75) 0%,
                    transparent 45%,
                    rgba(0,0,0,.45) 100%
                );
        }



        /* =====================================================
           HERO CONTENT
        ====================================================== */

        .hero-content {

            position:
                relative;

            z-index:
                2;

            width:
                100%;
        }


        .hero-topline {

            display:
                flex;

            justify-content:
                space-between;

            border-top:
                1px solid
                rgba(255,255,255,.25);

            padding-top:
                12px;

            margin-bottom:
                90px;

            color:
                rgba(255,255,255,.65);

            font-size:
                10px;

            letter-spacing:
                .16em;
        }


        .eyebrow {

            color:
                var(--accent);

            font-size:
                11px;

            font-weight:
                700;

            letter-spacing:
                .18em;

            margin-bottom:
                20px;
        }


        .hero h1 {

            font-size:
                clamp(
                    58px,
                    8.5vw,
                    135px
                );

            line-height:
                .86;

            letter-spacing:
                -.075em;

            font-weight:
                800;

            text-transform:
                uppercase;

            margin:
                0 0 55px;

            max-width:
                1250px;
        }


        .hero h1 em {

            color:
                rgba(255,255,255,.45);

            font-style:
                normal;
        }



        /* =====================================================
           CHANGING SERVICE
        ====================================================== */

        .changing-wrap {

            display:
                inline-block;

            min-width:
                6.5em;

            overflow:
                hidden;

            vertical-align:
                top;
        }


        .changing-service {

            display:
                inline-block;

            color:
                var(--accent);
        }


        .changing-service.exit {

            animation:
                serviceOut
                .35s
                ease
                forwards;
        }


        .changing-service.enter {

            animation:
                serviceIn
                .45s
                cubic-bezier(
                    .2,
                    .8,
                    .2,
                    1
                )
                forwards;
        }


        @keyframes serviceOut {

            to {

                opacity:
                    0;

                transform:
                    translateY(
                        -35px
                    );

                filter:
                    blur(7px);
            }
        }


        @keyframes serviceIn {

            from {

                opacity:
                    0;

                transform:
                    translateY(
                        35px
                    );

                filter:
                    blur(7px);
            }

            to {

                opacity:
                    1;

                transform:
                    none;

                filter:
                    none;
            }
        }



        /* =====================================================
           HERO BOTTOM
        ====================================================== */

        .hero-bottom {

            display:
                flex;

            justify-content:
                space-between;

            align-items:
                flex-end;

            max-width:
                950px;
        }


        .hero-description {

            max-width:
                430px;

            color:
                rgba(255,255,255,.70);

            font-size:
                14px;

            line-height:
                1.7;
        }


        .circle-link {

            width:
                125px;

            height:
                125px;

            border:
                1px solid
                rgba(255,255,255,.35);

            border-radius:
                50%;

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            flex-direction:
                column;

            font-size:
                9px;

            letter-spacing:
                .13em;

            text-align:
                center;

            transition:
                .4s;
        }


        .circle-link span:last-child {

            color:
                var(--accent);
        }


        .circle-link:hover {

            background:
                var(--accent);

            border-color:
                var(--accent);

            transform:
                rotate(
                    -10deg
                );
        }



        /* =====================================================
           SERVICE SLIDER
        ====================================================== */

        .services-slider {

            background:
                #111;

            border-top:
                1px solid
                var(--line);

            border-bottom:
                1px solid
                var(--line);

            overflow:
                hidden;

            padding:
                28px 0;
        }


        .services-track {

            display:
                flex;

            width:
                max-content;

            animation:
                servicesMarquee
                30s
                linear
                infinite;
        }


        .service-slide {

            display:
                flex;

            align-items:
                center;

            gap:
                45px;

            padding:
                0 45px;

            white-space:
                nowrap;
        }


        .service-slide strong {

            font-size:
                clamp(
                    22px,
                    3vw,
                    42px
                );

            letter-spacing:
                -.04em;

            text-transform:
                uppercase;
        }


        .service-slide span {

            color:
                var(--accent);

            font-size:
                20px;
        }


        @keyframes servicesMarquee {

            to {

                transform:
                    translateX(-50%);
            }
        }



        /* =====================================================
           CLIENTS
        ====================================================== */

        .clients {

            padding:
                100px 0;

            border-bottom:
                1px solid
                var(--line);
        }


        .section-label {

            color:
                var(--accent);

            font-size:
                10px;

            letter-spacing:
                .18em;

            font-weight:
                700;
        }


        .clients-title {

            font-size:
                clamp(
                    45px,
                    6vw,
                    85px
                );

            line-height:
                .9;

            letter-spacing:
                -.065em;

            text-transform:
                uppercase;

            font-weight:
                800;

            margin:
                18px 0 60px;
        }


        .logos-wrapper {

            overflow:
                hidden;
        }


        .logos-track {

            display:
                flex;

            align-items:
                center;

            width:
                max-content;

            animation:
                logosMove
                35s
                linear
                infinite;
        }


        .client-logo {

            min-width:
                190px;

            height:
                80px;

            margin-right:
                25px;

            border:
                1px solid
                var(--line);

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            color:
                #777;

            font-size:
                14px;

            font-weight:
                700;

            letter-spacing:
                .08em;

            text-transform:
                uppercase;

            transition:
                .3s;
        }


        .client-logo:hover {

            color:
                white;

            border-color:
                var(--accent);
        }


        @keyframes logosMove {

            to {

                transform:
                    translateX(-50%);
            }
        }



        /* =====================================================
           PROJECTS
        ====================================================== */

        .projects {

            padding:
                150px 0;
        }


        .section-heading {

            display:
                flex;

            justify-content:
                space-between;

            align-items:
                flex-end;

            margin-bottom:
                70px;
        }


        .section-number {

            color:
                var(--accent);

            font-size:
                10px;

            letter-spacing:
                .18em;
        }


        .section-heading h2 {

            font-size:
                clamp(
                    55px,
                    7vw,
                    110px
                );

            line-height:
                .88;

            letter-spacing:
                -.07em;

            text-transform:
                uppercase;

            font-weight:
                800;

            margin:
                18px 0 0;
        }


        .section-heading h2 span {

            color:
                #555;
        }


        .section-heading p {

            max-width:
                330px;

            color:
                #888;

            font-size:
                13px;

            line-height:
                1.7;
        }



        /* =====================================================
           PROJECT FILTERS
        ====================================================== */

        .project-filters {

            display:
                flex;

            flex-wrap:
                wrap;

            gap:
                10px;

            margin-bottom:
                45px;
        }


        .filter-btn {

            border:
                1px solid
                var(--line);

            background:
                transparent;

            color:
                #888;

            border-radius:
                50px;

            padding:
                10px 18px;

            font-size:
                10px;

            letter-spacing:
                .1em;

            text-transform:
                uppercase;

            transition:
                .3s;
        }


        .filter-btn:hover,
        .filter-btn.active {

            background:
                var(--accent);

            border-color:
                var(--accent);

            color:
                white;
        }



        /* =====================================================
           PROJECT CARDS
        ====================================================== */

        .project-card {

            position:
                relative;

            display:
                block;

            min-height:
                520px;

            overflow:
                hidden;

            background:
                #151515;

            margin-bottom:
                24px;
        }


        .project-large {

            min-height:
                680px;
        }


        .project-image {

            position:
                absolute;

            inset:
                0;

            transition:
                transform
                .8s
                cubic-bezier(
                    .2,
                    .7,
                    .2,
                    1
                );
        }


        .project-card:hover
        .project-image {

            transform:
                scale(
                    1.06
                );
        }


        .project-video {

            background:
                linear-gradient(
                    135deg,
                    #3d2418,
                    #0a0a0a 60%,
                    #712b12
                );
        }


        .project-photo {

            background:
                linear-gradient(
                    145deg,
                    #272727,
                    #68645d
                );
        }


        .project-web {

            background:
                linear-gradient(
                    135deg,
                    #1b2030,
                    #090909 60%,
                    #314a65
                );
        }


        .project-brand {

            background:
                linear-gradient(
                    135deg,
                    #271e2b,
                    #111 55%,
                    #75432d
                );
        }


        .project-social {

            background:
                linear-gradient(
                    135deg,
                    #122722,
                    #0b0b0b 60%,
                    #1c6555
                );
        }


        .project-overlay {

            position:
                absolute;

            inset:
                0;

            padding:
                30px;

            display:
                flex;

            align-items:
                flex-end;

            justify-content:
                space-between;

            background:
                linear-gradient(
                    transparent 35%,
                    rgba(0,0,0,.88)
                );
        }


        .project-overlay small {

            color:
                var(--accent);

            font-size:
                9px;

            letter-spacing:
                .16em;

            font-weight:
                700;
        }


        .project-overlay h3 {

            font-size:
                clamp(
                    28px,
                    3vw,
                    48px
                );

            line-height:
                .95;

            letter-spacing:
                -.05em;

            margin:
                8px 0 0;
        }


        .project-arrow {

            color:
                var(--accent);

            font-size:
                35px;
        }



        /* =====================================================
           SERVICES DETAIL
        ====================================================== */

        .services-detail {

            background:
                #f0eee8;

            color:
                #111;

            padding:
                150px 0;
        }


        .services-detail .section-number {

            color:
                var(--accent);
        }


        .services-list {

            border-top:
                1px solid
                #bbb;
        }


        .service-row {

            display:
                grid;

            grid-template-columns:
                70px
                1.1fr
                1fr
                40px;

            align-items:
                center;

            gap:
                30px;

            padding:
                30px 0;

            border-bottom:
                1px solid
                #bbb;

            transition:
                .3s;
        }


        .service-row:hover {

            padding-left:
                15px;

            background:
                #e6e3db;
        }


        .service-row h3 {

            font-size:
                clamp(
                    32px,
                    4vw,
                    65px
                );

            letter-spacing:
                -.06em;

            margin:
                0;
        }


        .service-row p {

            color:
                #666;

            font-size:
                13px;

            line-height:
                1.6;

            max-width:
                350px;
        }


        .service-row b {

            color:
                var(--accent);

            font-size:
                25px;
        }



        /* =====================================================
           TEAM
        ====================================================== */

        .team {

            padding:
                150px 0;
        }


        .team-card {

            position:
                relative;

            overflow:
                hidden;

            background:
                #151515;

            min-height:
                480px;
        }


        .team-photo {

            position:
                absolute;

            inset:
                0;

            background:
                linear-gradient(
                    145deg,
                    #252525,
                    #555
                );

            transition:
                .6s;
        }


        .team-card:hover
        .team-photo {

            transform:
                scale(
                    1.05
                );
        }


        .team-info {

            position:
                absolute;

            bottom:
                0;

            left:
                0;

            right:
                0;

            padding:
                25px;

            background:
                linear-gradient(
                    transparent,
                    rgba(0,0,0,.9)
                );
        }


        .team-info small {

            color:
                var(--accent);

            font-size:
                9px;

            letter-spacing:
                .14em;
        }


        .team-info h3 {

            margin:
                7px 0 0;

            font-size:
                28px;
        }



        /* =====================================================
           ABOUT
        ====================================================== */

        .about {

            background:
                var(--accent);

            color:
                #111;

            padding:
                150px 0;
        }


        .about h2 {

            font-size:
                clamp(
                    55px,
                    7vw,
                    110px
                );

            line-height:
                .88;

            letter-spacing:
                -.07em;

            text-transform:
                uppercase;

            font-weight:
                800;

            max-width:
                1250px;
        }


        .about h2 span {

            color:
                rgba(0,0,0,.4);
        }


        .about-meta {

            display:
                flex;

            gap:
                30px;

            margin-top:
                70px;

            padding-top:
                20px;

            border-top:
                1px solid
                rgba(0,0,0,.2);

            font-size:
                10px;

            letter-spacing:
                .15em;
        }



        /* =====================================================
           CONTACT
        ====================================================== */

        .contact {

            padding:
                170px 0
                150px;
        }


        .contact h2 {

            font-size:
                clamp(
                    65px,
                    10vw,
                    150px
                );

            line-height:
                .84;

            letter-spacing:
                -.075em;

            text-transform:
                uppercase;

            font-weight:
                800;

            margin:
                25px 0 80px;
        }


        .contact h2 em {

            color:
                var(--accent);

            font-style:
                normal;
        }


        .contact-bottom {

            display:
                flex;

            justify-content:
                space-between;

            align-items:
                flex-end;

            border-top:
                1px solid
                var(--line);

            padding-top:
                25px;
        }


        .contact-bottom p {

            color:
                #888;

            font-size:
                14px;

            line-height:
                1.7;
        }


        .contact-button {

            border-bottom:
                1px solid
                var(--accent);

            padding-bottom:
                10px;

            font-size:
                11px;

            letter-spacing:
                .13em;

            transition:
                .3s;
        }


        .contact-button:hover {

            color:
                var(--accent);

            padding-right:
                12px;
        }



        /* =====================================================
           FOOTER
        ====================================================== */

        footer {

            border-top:
                1px solid
                var(--line);

            padding:
                45px 0
                25px;
        }


        .footer-top {

            display:
                flex;

            justify-content:
                space-between;

            align-items:
                center;

            padding-bottom:
                60px;
        }


        .footer-links {

            display:
                flex;

            gap:
                30px;
        }


        .footer-links a {

            color:
                #777;

            font-size:
                10px;

            text-transform:
                uppercase;

            letter-spacing:
                .1em;
        }


        .footer-bottom {

            display:
                flex;

            justify-content:
                space-between;

            padding-top:
                20px;

            border-top:
                1px solid
                var(--line);

            color:
                #555;

            font-size:
                9px;

            text-transform:
                uppercase;

            letter-spacing:
                .1em;
        }



        /* =====================================================
           MOBILE
        ====================================================== */

        @media(max-width: 991px) {

            .hero-topline {

                margin-bottom:
                    60px;
            }


            .service-row {

                grid-template-columns:
                    45px
                    1fr
                    30px;
            }


            .service-row p {

                grid-column:
                    2 / 4;
            }

        }



        @media(max-width: 575px) {

            .navbar {

                padding:
                    20px 0;
            }


            .hero {

                min-height:
                    800px;
            }


            .hero-topline span:last-child {

                display:
                    none;
            }


            .hero h1 {

                font-size:
                    53px;

                margin-bottom:
                    45px;
            }


            .hero-bottom {

                gap:
                    20px;
            }


            .hero-description {

                font-size:
                    12px;
            }


            .circle-link {

                width:
                    95px;

                height:
                    95px;

                flex:
                    0 0 auto;
            }


            .clients {

                padding:
                    80px 0;
            }


            .projects,
            .team {

                padding:
                    90px 0;
            }


            .section-heading {

                display:
                    block;

                margin-bottom:
                    45px;
            }


            .section-heading p {

                margin-top:
                    25px;
            }


            .project-card,
            .project-large {

                min-height:
                    430px;
            }


            .services-detail,
            .about {

                padding:
                    90px 0;
            }


            .service-row {

                grid-template-columns:
                    40px
                    1fr
                    30px;

                gap:
                    12px;

                padding:
                    25px 0;
            }


            .service-row h3 {

                font-size:
                    34px;
            }


            .service-row p {

                grid-column:
                    2 / 4;
            }


            .about-meta {

                flex-wrap:
                    wrap;

                gap:
                    15px;

                margin-top:
                    50px;
            }


            .contact {

                padding:
                    100px 0;
            }


            .contact h2 {

                font-size:
                    60px;
            }


            .contact-bottom {

                display:
                    block;
            }


            .contact-button {

                display:
                    inline-block;

